# =====================================================================
#  야외활동 지수 설정 파일 (수동 설치용)
#  1) 이 파일을 Tomcat 폴더의 conf 폴더에 outdoor-index.properties 이름으로 복사
#     예) C:\Program Files\Apache Software Foundation\Tomcat 11.0\conf\outdoor-index.properties
#  2) 아래 MySQL 비밀번호를 이 PC의 MySQL 비밀번호로 바꾸기
#  3) Tomcat 다시 시작
#  - 한 줄에 KEY=값 하나. 값에 따옴표 필요 없음. # 으로 시작하면 주석
#  - MySQL 세 줄을 지우면(또는 # 처리하면) 내장 DB(H2)를 사용
# =====================================================================

# 공공데이터포털 서비스키 (Decoding 키, 팀 공용) - 외부에 공유하지 마세요
OUTDOOR_SERVICE_KEY=__SERVICE_KEY__

# MySQL (outdoor_index 데이터베이스와 테이블은 처음 실행할 때 자동으로 만들어짐)
OUTDOOR_DB_URL=jdbc:mysql://localhost:3306/outdoor_index
OUTDOOR_DB_USER=root
OUTDOOR_DB_PASSWORD=여기에_MySQL_비밀번호

# auto   : 평소처럼 실시간 조회, 성공한 응답은 저장해 두고 인터넷이 끊기면 저장된 응답 사용 (권장)
# replay : 인터넷 없이 저장된 응답만 사용 (발표장 인터넷이 불안할 때)
# off    : 저장 기능 끔
OUTDOOR_DEMO_MODE=auto

# 같은 요청을 다시 부르지 않고 기억해 두는 시간(초)
OUTDOOR_CACHE_TTL_SECONDS=600

# (선택) 저장 데이터 폴더. 비우면 Tomcat 폴더\outdoor-data
# OUTDOOR_DATA_DIR=C:\outdoor-data
