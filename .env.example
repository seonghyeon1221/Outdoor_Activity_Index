# =========================================================
#  야외활동 지수 설정 파일 (.env)
#  - 이 파일을 복사해서 .env 로 저장하고 값을 채우세요
#  - 같은 이름의 환경변수가 있으면 환경변수가 우선해요 (setup.sh 가 ~/.zshrc 에 등록)
# =========================================================

# 공공데이터포털 서비스키 (Decoding 키, 에어코리아·기상청 공통)
OUTDOOR_SERVICE_KEY=

# 서버 포트 (기본 8080, 이미 쓰는 중이면 8090 등으로 변경)
OUTDOOR_PORT=8080

# 시연 모드: auto(기본, 실시간 + 성공 응답 저장, 인터넷 끊기면 저장본 사용) / replay(인터넷 없이 저장본만) / off
OUTDOOR_DEMO_MODE=auto

# API 응답 캐시 시간(초). 같은 검색을 이 시간 안에 다시 하면 API를 다시 부르지 않음 (0 = 끔)
OUTDOOR_CACHE_TTL_SECONDS=600

# ---- MySQL (즐겨찾기 · 최근 검색 저장) ----
# 비워 두면 내장 H2 파일 DB(data/outdoor-db)를 사용
# outdoor_index 데이터베이스가 없으면 자동으로 만들어요
OUTDOOR_DB_URL=jdbc:mysql://localhost:3306/outdoor_index
OUTDOOR_DB_USER=root
OUTDOOR_DB_PASSWORD=

# ---- 아래는 보통 바꿀 필요 없음 ----
# OUTDOOR_DATA_DIR=./data   (저장 응답·DB 파일 위치)
# OUTDOOR_AIRKOREA_ENDPOINT=https://apis.data.go.kr/B552584/ArpltnInforInqireSvc
# OUTDOOR_KMA_ENDPOINT=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# OUTDOOR_HTTP_CONNECT_TIMEOUT=5000
# OUTDOOR_HTTP_REQUEST_TIMEOUT=10000
