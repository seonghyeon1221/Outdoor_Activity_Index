<?xml version="1.0" encoding="UTF-8"?>
<!-- 서블릿은 @WebServlet 으로 등록. 여기서는 시작 페이지, 세션 방식, 오류 화면만 지정 -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.1">
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <session-config>
        <tracking-mode>COOKIE</tracking-mode>   <!-- 주소에 ;jsessionid 가 붙지 않게 -->
    </session-config>
    <error-page>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
</web-app>
